#!/usr/bin/env python3
import socket
import struct
import numpy as np
from pynq import Overlay, allocate, MMIO

OVERLAY_PATH = "/home/xilinx/jupyter_notebooks/col_accel/top_bd.bit"
N_MAX        = 256
RECORD_BYTES = 32

# Register offsets from xcol_hw.h
# s_axi_control (0x40000000): ap_ctrl, N, frame_dt, restitution
CTRL_OFFSET         = 0x00
N_OFFSET            = 0x10
FRAME_DT_OFFSET     = 0x18
RESTITUTION_OFFSET  = 0x20

# s_axi_control_r (0x40010000): state_in and state_out pointer addresses
STATE_IN_LO         = 0x10
STATE_IN_HI         = 0x14
STATE_OUT_LO        = 0x1c
STATE_OUT_HI        = 0x20

def main():
    print("Loading overlay...")
    ol = Overlay(OVERLAY_PATH)
    print("Overlay loaded!")

    # PYNQ maps col_0.mmio to control_r (0x40010000) — confirmed from ip_dict
    # control (0x40000000) must be accessed directly via MMIO
    mmio_r = ol.col_0.mmio          # s_axi_control_r: pointer args (state_in, state_out)
    mmio   = MMIO(0x40000000, 0x40) # s_axi_control:   scalar args + ap_ctrl

    print(f"control   base = 0x40000000")
    print(f"control_r base = 0x40010000")

    # Allocate physically-contiguous DRAM buffers
    buf_in  = allocate(shape=(N_MAX * RECORD_BYTES,), dtype=np.uint8)
    buf_out = allocate(shape=(N_MAX * RECORD_BYTES,), dtype=np.uint8)
    print(f"buf_in  phys = 0x{buf_in.physical_address:08x}")
    print(f"buf_out phys = 0x{buf_out.physical_address:08x}")

    # Write buffer addresses into control_r once (buffers are pinned, never move)
    mmio_r.write(STATE_IN_LO,  buf_in.physical_address         & 0xFFFFFFFF)
    mmio_r.write(STATE_IN_HI,  (buf_in.physical_address >> 32) & 0xFFFFFFFF)
    mmio_r.write(STATE_OUT_LO, buf_out.physical_address         & 0xFFFFFFFF)
    mmio_r.write(STATE_OUT_HI, (buf_out.physical_address >> 32) & 0xFFFFFFFF)
    print("Buffer addresses written to control_r")

    # Verify what we wrote
    print(f"  state_in  lo = 0x{mmio_r.read(STATE_IN_LO):08x}")
    print(f"  state_in  hi = 0x{mmio_r.read(STATE_IN_HI):08x}")
    print(f"  state_out lo = 0x{mmio_r.read(STATE_OUT_LO):08x}")
    print(f"  state_out hi = 0x{mmio_r.read(STATE_OUT_HI):08x}")

    def run_kernel(n, frame_dt_q, restitution_q, payload):
        n_bytes = n * RECORD_BYTES

        # Copy asteroid data into physically-contiguous buffer
        buf_in[:n_bytes] = np.frombuffer(payload, dtype=np.uint8)
        buf_in.flush()

        # Write scalar arguments to control
        mmio.write(N_OFFSET,           n)
        mmio.write(FRAME_DT_OFFSET,    frame_dt_q)
        mmio.write(RESTITUTION_OFFSET, restitution_q)

        # Fire: write ap_start (bit 0) to control
        mmio.write(CTRL_OFFSET, 0x01)

        # Poll ap_done (bit 1) with tight 1µs loop
        import time
        for _ in range(100000):
            status = mmio.read(CTRL_OFFSET)
            if status & 0x02:
                break
            time.sleep(1e-6)
        else:
            print("WARNING: kernel timeout!")

        # Invalidate cache and read results
        buf_out.invalidate()
        return bytes(buf_out[:n_bytes])

    def recv_exact(sock, n):
        buf = bytearray()
        while len(buf) < n:
            chunk = sock.recv(n - len(buf))
            if not chunk:
                return None
            buf.extend(chunk)
        return bytes(buf)

    # Start TCP server
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as srv:
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind(("0.0.0.0", 5005))
        srv.listen(1)
        print("Server listening on port 5005...")

        while True:
            conn, addr = srv.accept()
            print(f"Connected: {addr}")
            with conn:
                conn.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
                while True:
                    hdr = recv_exact(conn, 12)
                    if not hdr:
                        break
                    n, dt_q, rest_q = struct.unpack("<III", hdr)
                    if n == 0 or n > N_MAX:
                        continue
                    payload = recv_exact(conn, n * RECORD_BYTES)
                    if payload is None:
                        break
                    result = run_kernel(n, dt_q, rest_q, payload)
                    conn.sendall(result)
            print(f"Disconnected: {addr}")

if __name__ == "__main__":
    main()
